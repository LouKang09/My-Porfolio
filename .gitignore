# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# Runtime authentication + private/public interaction data
/data/admin-auth.json
/data/messages.json
/data/gallery-social.json
/data/backups/
/data/*.tmp

# User uploads are runtime data (Railway volume), not source code
/uploads/*
!/uploads/.gitkeep

# Local backups / working copies
/public-backup/
public-backup/
*.bak
*.backup

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tmp
*.temp

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Railway local state, if created
.railway/
